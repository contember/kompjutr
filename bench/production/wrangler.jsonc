{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kompjutr-git-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE",
        "class_name": "ProductionProbe"
      }
    ]
  },
  "exports": {
    "ProductionProbe": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
