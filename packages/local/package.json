{
  "name": "@kompjutr/local",
  "version": "0.0.0",
  "description": "Unix local SQLite Git workspace runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contember/kompjutr.git",
    "directory": "packages/local"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
