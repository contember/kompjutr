{
  "name": "kompjutr",
  "version": "0.0.0",
  "description": "SQLite-native git backend for Cloudflare Computer: objects, refs and index live in the Durable Object database, the working tree lives in DOFS.",
  "license": "MIT AND LGPL-2.1-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/core/diff/LICENSE",
    "LICENSE",
    "LICENSES",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "check": "biome check .",
    "bench": "node --experimental-transform-types --import ./bench/register.mjs bench/run.ts",
    "bench:macro": "node --experimental-transform-types --import ./bench/register.mjs bench/run.ts --scenarios=macro-packed,macro-loose"
  },
  "dependencies": {
    "pako": "^2.1.0"
  },
  "peerDependencies": {
    "@cloudflare/computer": ">=0.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/computer": "^0.2.1",
    "@platformatic/vfs": "^0.4.0",
    "@types/node": "^24.0.0",
    "@types/pako": "^2.0.3",
    "diff": "^9.0.0",
    "isomorphic-git": "^1.41.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
