{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "useNamingConvention": "off" }
    }
  },
  // bench/.fixtures holds cloned repositories, several of which carry their
  // own biome.json and would be read as nested roots.
  "files": { "includes": ["**", "!dist", "!node_modules", "!bench/.fixtures"] }
}
